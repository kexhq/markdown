# An example run as a workspace member: it depends on the Markdown package
# at the root of this checkout, not a published release.
package "from-file" do
  version("0.1.0")
  description("Markdown example: read a .md file from disk and render it")
  kex(">= 0.4.0-beta.2")
  license("MIT")

  entrypoint("src/main.kex")

  tey("markdown", workspace: true)
end
