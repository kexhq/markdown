module Markdown.Inline

using Parsing
using URI

let toHtml(text: String) -> String do
  return loopText(Input { input: text }, "")
end

let loopText(cursor: Input, output: String) -> String do
  return output if cursor.atEnd?
  let text = cursor.remaining
  if text.startsWith?("\\") && text.count > 1
    return loopText(cursor.advanceBy(2), output + esc(text.drop(1).take(1)))
  end
  if text.startsWith?("`")
    let (fence, afterFence) = cursor.takeWhile { |c| c == '`' }
    match find(afterFence.remaining, fence, 0) do
      Just(endAt) => do
        let literal = afterFence.remaining.take(endAt)
        let normalized = literal.startsWith?(" ") && literal.endsWith?(" ") && literal.trim != "" then literal.drop(1).take(literal.count - 2) else literal
        return loopText(afterFence.advanceBy(endAt + fence.count), output + "<code>${esc(normalized)}</code>")
      end
      None => ()
    end
  end
  let image? = text.startsWith?("![")
  if image? || text.startsWith?("[")
    let opening = image? then 2 else 1
    match find(text, "](", opening) do
      Just(labelEnd) => do
        let urlStart = labelEnd + 2
        match find(text, ")", urlStart) do
          Just(urlEnd) => do
            let label = text.drop(opening).take(labelEnd - opening)
            let url = safeURL(text.drop(urlStart).take(urlEnd - urlStart))
            let html = image? then "<img src=\"${esc(url)}\" alt=\"${esc(label)}\">" else "<a href=\"${esc(url)}\">${toHtml(label)}</a>"
            return loopText(cursor.advanceBy(urlEnd + 1), output + html)
          end
          None => ()
        end
      end
      None => ()
    end
  end
  let marker = if text.startsWith?("**")
    "**"
  elif text.startsWith?("~~")
    "~~"
  elif text.startsWith?("*")
    "*"
  elif text.startsWith?("_")
    "_"
  else
    ""
  end
  if marker != ""
    match find(text, marker, marker.count) do
      Just(closing) => do
        let tag = marker == "**" then "strong" else (marker == "~~" then "s" else "em")
        let inner = text.drop(marker.count).take(closing - marker.count)
        return loopText(cursor.advanceBy(closing + marker.count), output + "<${tag}>${toHtml(inner)}</${tag}>")
      end
      None => ()
    end
  end
  return loopText(cursor.advance, output + esc(text.take(1)))
end

# Position of needle at or after at, in characters. Splitting is linear,
# where comparing a fresh suffix at every position was quadratic.
let find(text: String, needle: String, at: Integer) -> Integer? do
  return None if at + needle.count > text.count
  let parts = text.drop(at).split(needle)
  return None if parts.count < 2
  return Just(at + parts.first.or("").count)
end

# Only http(s), mailto, and scheme-relative-but-not-protocol-relative
# references survive; anything else (a stray `javascript:`, a bare `//host`)
# becomes "#" rather than reaching an href or src.
let safeURL(url: String) -> String do
  match URI.fromIRI(url) do
    Error(_) => "#"
    Ok(reference) => do
      let scheme = reference.scheme.or("")
      return "#" if !["", "https", "http", "mailto"].contains?(scheme)
      return "#" if scheme == "" && reference.string.startsWith?("//")
      return reference.string
    end
  end
end

let esc(s: String) -> String do
  return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
end
